# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template carries no real secret and must ship, so contributors
# and the Vercel deploy know which variables to set.
!.env.example

# vercel
.vercel

# Claude Code worktrees (nested git checkouts for background sessions)
.claude/worktrees/

# typescript
*.tsbuildinfo
next-env.d.ts

# Local Academia discovery output (masked, but may contain course/faculty names)
scripts/discovery-report.txt
scripts/.session.json
scripts/inspect-report.txt
scripts/structure-report.txt
scripts/day-order-report.txt
